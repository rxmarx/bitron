{
  "name": "bitron",
  "private": true,
  "workspaces": [
    "packages/*",
    "prisma"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "dev": "yarn workspace api start:dev && yarn workspace client dev",
    "lint": "eslint . --ext .ts --ignore-path .gitignore",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.14.0"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@prisma/client": "^6.12.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.44.1"
  }
}
